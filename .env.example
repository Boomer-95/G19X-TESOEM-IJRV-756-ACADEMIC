# Plantilla sin credenciales. Completar localmente; no sobrescribir un .env existente.
# PostgreSQL / Docker (obligatorias para Compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Backend local: completar DATABASE_URL; Docker construye la URL usando DB_HOST.
DATABASE_URL=
# DB_HOST=

# Microsoft Entra: SPA y API del registro existente, sin client secret.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
# ENTRA_REQUIRED_SCOPE=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=
VITE_ENTRA_REDIRECT_URI=http://localhost:8080/
# VITE_API_URL=
# CORS_ORIGINS=

# Groq: seleccionar modelos habilitados en la cuenta.
GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_SMS_MODEL=

# Opcionales: dejar comunicaciones reales deshabilitadas mientras se configura.
COMMUNICATIONS_REAL_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
